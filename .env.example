# Required for OpenAI model calls. Replace this placeholder with your API key.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional. Defaults to gpt-6-luna when unset.
OPENAI_MODEL="gpt-6-luna"

# Optional. Set this to use the official TypeSafe Jev System One API first.
# JEV_API_KEY is also accepted as an alias.
TYPESAFE_API_KEY=""

# Optional. Server port; defaults to 3000.
PORT=3000

# Optional. Set to true to disable Vite HMR in development.
DISABLE_HMR=false
