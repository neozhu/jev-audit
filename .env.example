# OPENAI_API_KEY: Required for OpenAI model calls.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Optional model ID for OpenAI calls (defaults to gpt-6-luna).
OPENAI_MODEL="gpt-6-luna"

# TYPESAFE_API_KEY (or JEV_API_KEY): Official API key for TypeSafe Jev System One model.
# Obtain from https://console.typesafe.ai/settings/keys
# Used to call https://api.typesafe.ai/v1/systemone directly for machine-native typed Jev evaluation.
TYPESAFE_API_KEY="MY_TYPESAFE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
